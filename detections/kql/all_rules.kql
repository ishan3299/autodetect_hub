// Malicious Domains - Chunk 1 (Source: OTX)
DNS
| where QueryName has_any (
    "malicious-example.com"
  )
| extend ThreatSource = "OTX"
| extend ThreatIndicator = QueryName


// Malicious IPs - Chunk 1 (Source: OTX)
DeviceNetworkEvents
| where RemoteIP in (
    "192.168.1.100"
  )
| extend ThreatSource = "OTX"
| extend ThreatIndicator = RemoteIP


// Malicious IPs - Chunk 1 (Source: FeodoTracker)
DeviceNetworkEvents
| where RemoteIP in (
    "162.243.103.246",
    "50.16.16.211",
    "34.204.119.63",
    "178.62.3.223",
    "27.133.154.218"
  )
| extend ThreatSource = "FeodoTracker"
| extend ThreatIndicator = RemoteIP


